# EVM wallet address to receive x402 payments (Base mainnet)
WALLET_ADDRESS=0xYourWalletAddressHere

# Chain/network identifier (Base mainnet)
NETWORK_ID=eip155:8453

# CDP Facilitator URL (default - do not change)
FACILITATOR_URL=https://api.developer.coinbase.com/rpc/v1/base/facilitator

# Public URL of this deployment (used in payment requirements)
NEXT_PUBLIC_BASE_URL=https://your-deployment.vercel.app
